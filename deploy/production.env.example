# Copy to backend/.env on the server and fill in. Never commit the filled file.

# --- Database (the password is used by both Postgres and the app) ---
POSTGRES_PASSWORD=change-me-long-random
DATABASE_URL=postgresql+asyncpg://contentor:change-me-long-random@postgres:5432/contentor
REDIS_URL=redis://redis:6379/0

# --- Google (same values as local .env; the JSON goes to backend/credentials/) ---
GEMINI_API_KEY=
GCP_PROJECT_ID=
GCP_LOCATION=us-central1

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=contentorai_bot

# --- Site ---
SITE_URL=https://contentor.wtf
CORS_ORIGINS=["https://contentor.wtf","https://www.contentor.wtf"]
ADMIN_COOKIE_SECURE=true
SUPPORT_CONTACT=

# --- Monitoring: your Telegram id (from @userinfobot) or a group id; /start the bot first ---
ALERT_CHAT_ID=

# --- Off-server backups: rclone remote and folder, e.g. gdrive:contentor-backups ---
BACKUP_REMOTE=

# --- Payme / Click: leave empty until the merchant IDs arrive ---
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST=true
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# MINIAPP_DEV_TELEGRAM_ID must NOT be set in production.
